{
  "name": "krishimitra",
  "version": "1.0.0",
  "description": "KrishiMitra - Smart Farming Decision Assistant for Indian Farmers",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/src/index.js",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "client:build": "npm --prefix client build",
    "test:server": "node server/test-server.js",
    "setup:db": "node server/setup-db.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1"
  }
}
